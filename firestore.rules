rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // CONFIGURAÇÕES ADMIN
    match /configuracoes_admin/{document} {
      allow read, write: if true;
    }
    
    // USUÁRIOS
    match /usuarios/{userId} {
      allow read, write: if true;
    }
    
    // OFICINAS E TODAS SUBCOLEÇÕES (livre para tudo funcionar)
    match /oficinas/{document=**} {
      allow read, write: if true;
    }
    
    // BUSCA GLOBAL POR COLLECTION GROUP (coleção 'os')
    match /{path=**}/os/{osId} {
      allow read, write: if true;
    }
  }
}
