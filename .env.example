# Chaves nunca versionadas. Copie para .env e preencha.
# As chaves de IA ficam SEM o prefixo VITE_ (lidas só pelo proxy /api/ai).
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=

# Firebase (públicas por natureza — security rules fazem o controle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correspondente / Crédito
# false = checklist de documentos funciona apenas com controle de status
# (nenhum upload). Ligue só depois de publicar storage.rules e ter o claim oficinaId.
VITE_STORAGE_ATIVO=false

# --- Serverless (/api) ---
# Integração com portais usa service account para ler/escrever no Firestore.
# Cole o JSON inteiro (uma linha) ou o mesmo conteúdo em base64.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opcional: sobrescreve o project_id da service account
# FIREBASE_PROJECT_ID=express-ai-automation

# --- Checkout dos planos pagos ---
# Links de pagamento do Asaas. Vazio => o código usa o link público padrão de
# src/lib/checkout.js (LINK_ASAAS_PADRAO): Essencial Plus R$ 39,90 e PRO R$ 99,00.
# Os demais planos (Automação Sofia, Presença Digital) continuam indo pelo
# WhatsApp comercial (VITE_SU_WPP) com plano, e-mail e ID prontos.
# Essencial Plus — R$ 39,90
VITE_ASAAS_LINK_ESSENCIAL=
# PRO / Profissional — R$ 99,00
VITE_ASAAS_LINK_PRO=
# Opcional: link próprio do ciclo anual do PRO (vazio => usa VITE_ASAAS_LINK_PRO
# e, sem ele, o link padrão de R$ 99,00/mês — veja D-21.03/21.04 no Company Brain)
VITE_ASAAS_LINK_PRO_ANUAL=

# Legado: só é consultado quando não existe link do Asaas para o plano.
# Vazia => abre o WhatsApp comercial (VITE_SU_WPP) com plano, e-mail e ID prontos.
VITE_CHECKOUT_PRO_URL=
# URLs por ciclo (têm prioridade sobre a de cima):
# mensal -> VITE_CHECKOUT_PRO_MENSAL_URL, anual -> VITE_CHECKOUT_PRO_ANUAL_URL
VITE_CHECKOUT_PRO_MENSAL_URL=
VITE_CHECKOUT_PRO_ANUAL_URL=

# --- Webhook de pagamento (api/pagamento-webhook.js) ---
# Segredo do formato JSON direto (cabeçalho x-webhook-secret) e também o token
# de autenticação do webhook do Asaas (cabeçalho asaas-access-token).
WEBHOOK_SECRET=
# Opcional: API key do Asaas para descobrir o e-mail do pagador pelo customer_id
# quando o payload não traz externalReference/description utilizável.
# ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3 | Sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_API_URL=

# --- Autenticação dos proxies /api (produção) ---
# /api/ai e /api/places exigem Firebase ID token (Authorization: Bearer <token>)
# por padrão. O front envia esse token por src/lib/aiAuth.js (cabecalhosIA()).
#
# AI_REQUIRE_AUTH     — controla api/ai.js. Padrão: true
#                       sem token => 401 {codigo:'nao_autorizado', motivo}.
# PLACES_REQUIRE_AUTH — controla api/places.js. Padrão: true (mesmo 401).
#
# NUNCA deixe false em produção: o proxy usa as chaves de IA do servidor e, sem
# token, qualquer pessoa com a URL consome o seu crédito. Use false apenas em
# harness local (ex.: node tests/ai-proxy.test.mjs) e não commite esse .env.
AI_REQUIRE_AUTH=true
PLACES_REQUIRE_AUTH=true

# --- /api/places (prospecção por raio) ---
# Vazio => Nominatim/Overpass (gratuitos, 1 req/s). Preenchido => Google Places.
# GOOGLE_MAPS_API_KEY=
