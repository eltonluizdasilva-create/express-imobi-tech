# Chaves nunca versionadas. Copie para .env e preencha.
# As chaves de IA ficam SEM o prefixo VITE_ (lidas só pelo proxy /api/ai).
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=

# Firebase (públicas por natureza — security rules fazem o controle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correspondente / Crédito
# false = checklist de documentos funciona apenas com controle de status
# (nenhum upload). Ligue só depois de publicar storage.rules e ter o claim oficinaId.
VITE_STORAGE_ATIVO=false

# --- Serverless (/api) ---
# Integração com portais usa service account para ler/escrever no Firestore.
# Cole o JSON inteiro (uma linha) ou o mesmo conteúdo em base64.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opcional: sobrescreve o project_id da service account
# FIREBASE_PROJECT_ID=express-ai-automation

# --- Checkout do Plano PRO ---
# Se preenchida, o botão "Assinar Plano PRO Agora" abre esta URL (pagamento).
# Vazia => abre o WhatsApp comercial (VITE_SU_WPP) com plano, e-mail e ID prontos.
VITE_CHECKOUT_PRO_URL=
# URLs por ciclo (têm prioridade sobre a de cima):
# mensal -> VITE_CHECKOUT_PRO_MENSAL_URL, anual -> VITE_CHECKOUT_PRO_ANUAL_URL
VITE_CHECKOUT_PRO_MENSAL_URL=
VITE_CHECKOUT_PRO_ANUAL_URL=
